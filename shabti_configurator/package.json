{
	"name": "bun_installer",
	"module": "index.ts",
	"type": "module",
	"workspaces": ["client/"],
	"devDependencies": {
		"@types/adm-zip": "0.5.8",
		"@types/bun": "latest",
		"@types/lodash": "4.17.25",
		"@types/node-forge": "1.3.14"
	},
	"peerDependencies": {
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@iarna/toml": "2.2.5",
		"@keycloak/keycloak-admin-client": "26.6.4",
		"@std/ini": "npm:@jsr/std__ini",
		"@zxcvbn-ts/core": "3.0.4",
		"@zxcvbn-ts/language-common": "3.0.4",
		"@zxcvbn-ts/language-en": "3.0.2",
		"adm-zip": "0.5.18",
		"envfile": "7.1.0",
		"eventsource-client": "1.2.0",
		"hono": "4.13.1",
		"lodash": "4.18.1",
		"node-forge": "1.4.0",
		"semver": "7.8.5",
		"ts-humanize": "1.0.3"
	},
	"scripts": {
		"dev_client": "cd .. && bun build ./shabti_configurator/client/index.ts ./shabti_configurator/client/progress.ts --outdir ./shabti_configurator/assets --watch",
		"dev_server": "bun run --watch index.tsx --dev-mode",
		"dev_install": "bun run --parallel dev_client dev_server",
		"build_zip": "bun run ./zipDockerCompose.ts",
		"build_client": "bun build ./client/index.ts ./client/progress.ts --outdir ./assets --minify",
		"build_win": "bun run build_zip && bun run build_client && bun build ./index.tsx --compile --target=bun-windows-x64 --outfile dist/windows/shabti",
		"build_linux": "bun run build_zip && bun run build_client && bun build ./index.tsx --compile --target=bun-linux-x64 --outfile dist/linux/shabti",
		"build_mac": "bun run build_zip && bun run build_client && bun build ./index.tsx --compile --target=bun-darwin-arm64 --outfile dist/mac/shabti"
	},
	"version": "0.1.0"
}
