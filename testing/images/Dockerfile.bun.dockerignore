# keeping the host's node_modules out is the point of copying the repo in rather than mounting it
**/node_modules
.git

# the checked in virtualenv at the repository root
Lib/
Include/
Scripts/
share/
etc/
.venv/
pyvenv.cfg
**/__pycache__
**/*.py[cod]

# build output and test artefacts
**/dist
testing/test_results
testing/processed_test_runs
testing/self_signed_certificates
shabti_configurator/assets/docker_compose.zip
shabti_configurator/assets/index.js
shabti_configurator/assets/progress.js
shabti_configurator/assets/index.css

# nothing in the image needs these, and they carry generated secrets
**/.env
testing/env/.generated.env
