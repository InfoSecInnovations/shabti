# Every bun suite runs in here so results don't depend on the developer's machine. The repo is
# copied in rather than bind mounted, because a bind mount would bring the host's node_modules with
# it -- native binaries built for the wrong platform being exactly the class of problem this is
# meant to remove. Only /test_results is mounted, for the JUnit output.
#
# versioning/versions.ts shells out to `uv version`, so uv has to be a real binary in here. Building
# on the image that ships it -- the same pin as docker_containers/shabti_api/Dockerfile, so there is
# one uv version in the repo rather than two -- also means the bundled Python satisfies the
# requires-python the fixtures declare. bun is a single static binary and copies in cleanly.
FROM astral/uv:0.12.18-python3.14-trixie-slim

COPY --from=oven/bun:1.4.2-slim /usr/local/bin/bun /usr/local/bin/bun
# what oven/bun's own image sets up for containers
ENV BUN_INSTALL_BIN=/usr/local/bin \
	BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
# bun dispatches on argv[0], and some package bin scripts carry a `node` shebang
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx \
	&& ln -s /usr/local/bin/bun /usr/local/bin/node

# versioning/tests/fixture.ts builds throwaway git repos on disk, so git has to be present
RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates git \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /repo

# manifests first, so editing a test doesn't reinstall the workspace. Every workspace member's
# package.json has to be here for bun to resolve the lockfile.
COPY package.json bun.lock ./
COPY shabti_api_client_node/package.json shabti_api_client_node/
COPY shabti_cli/package.json shabti_cli/
COPY shabti_configurator/package.json shabti_configurator/
COPY shabti_configurator/client/package.json shabti_configurator/client/
RUN bun install --frozen-lockfile

COPY . .

# shabti_cli imports the client through its package main, dist/index.js, and dist is deliberately
# not copied in. Only the runtime bundle is needed here; the type declarations are not.
RUN cd shabti_api_client_node && bun run build:js

CMD ["bun", "test"]
