{
	"name": "shabti",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"lock": "docker compose -f ./docker_containers/docker-compose-uv-lock.yml run --rm uv-lock",
		"components": "bun ./generateComponentsJson.ts",
		"bump": "bun ./versioning/bump.ts",
		"deps": "bun ./dependencies/check.ts",
		"deps:set": "bun ./dependencies/set.ts",
		"deps:migrate": "bun ./dependencies/migrate.ts",
		"gguf": "bun ./gguf/convert.ts",
		"test": "bun ./testing/run.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bun": "latest",
		"@types/semver": "7.8.0"
	},
	"peerDependencies": {
		"typescript": "5.9.3"
	},
	"workspaces": [
		"shabti_configurator/",
		"shabti_configurator/client/",
		"shabti_cli/",
		"shabti_api_client_node/"
	],
	"dependencies": {
		"commander": "15.0.0",
		"fast-xml-parser": "5.10.1",
		"octokit": "5.0.5",
		"semver": "7.8.5"
	},
	"version": "0.8.0"
}
